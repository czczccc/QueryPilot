# QueryPilot 环境变量示例：复制为 .env 并填入真实值，切勿提交 .env
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
APP_ENV=development
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=8
MAX_RESULTS=12
# 记忆库 SQLite 路径（留空关闭记忆）与后台复验周期（小时，0 关闭）
MEMORY_DB_PATH=data/querypilot.db
REVERIFY_INTERVAL_HOURS=6
# 额外搜索源：Telegram 公开频道用户名（逗号分隔，国内服务器需配 TG_PROXY）
TG_CHANNELS=
TG_PROXY=
# 资源站搜索 URL 模板（逗号分隔，{q} 为关键词），如 https://example.com/search?q={q}
EXTRA_SITES=
