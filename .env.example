# QueryPilot 环境变量示例：复制为 .env 并填入真实值，切勿提交 .env
DEEPSEEK_API_KEY=
# 可选：换成兼容 OpenAI 格式的第三方服务（留空为 DeepSeek 官方 + deepseek-v4-flash）
# LLM_BASE_URL 例：https://api.siliconflow.cn/v1（会自动补 /chat/completions）
# LLM_API_KEY 填了就优先于 DEEPSEEK_API_KEY；agent 规划需要模型支持 function calling
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# 流式：auto（默认，非流式请求被拒 400 时自动改用流式）/ true（始终流式）/ false
LLM_STREAM=auto
TAVILY_API_KEY=
APP_ENV=development
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=8
MAX_RESULTS=12
# 记忆库 SQLite 路径（留空关闭记忆）与后台复验周期（小时，0 关闭）
MEMORY_DB_PATH=data/querypilot.db
REVERIFY_INTERVAL_HOURS=6
# 额外搜索源：Telegram 公开频道用户名（逗号分隔，国内服务器需配 TG_PROXY）
TG_CHANNELS=
TG_PROXY=
# 资源站搜索 URL 模板（逗号分隔，{q} 为关键词），如 https://example.com/search?q={q}
EXTRA_SITES=
# 追剧订阅检查周期（小时，0 关闭）；有更新时额外推送到 webhook（可选，支持通用 {"text"} 与飞书机器人格式）
SUBSCRIBE_INTERVAL_HOURS=12
NOTIFY_WEBHOOK=
# 夸克扫码登录（默认开启）：每个用户扫码后转存到自己的网盘，登录凭证用 AES-256-GCM 加密存进记忆库
# COOKIE_SECRET 是加密密钥（任意长随机串）；留空则自动生成 data/.cookie_secret，换掉密钥后用户需重新扫码
QUARK_LOGIN=true
COOKIE_SECRET=
# 部署者自用的一键转存（可选，和扫码登录可同时存在）：夸克网页版登录后的 cookie，只放本地 .env，切勿提交或发给别人
# 两项都填写才开启；SAVE_TOKEN 是网页上点「转存」时要输入的口令，请用足够长的随机串
QUARK_COOKIE=
SAVE_TOKEN=
# 转存到的网盘目录 fid（网页版打开目标文件夹后地址栏里的 fid；不确定就保持 0，即根目录）
QUARK_SAVE_DIR_FID=0
