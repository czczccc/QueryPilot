# QueryPilot 环境变量示例：复制为 .env 并填入真实值，切勿提交 .env
DEEPSEEK_API_KEY=
# 可选：换成兼容 OpenAI 格式的第三方服务（留空为 DeepSeek 官方 + deepseek-v4-flash）
# LLM_BASE_URL 例：https://api.siliconflow.cn/v1（会自动补 /chat/completions）
# LLM_API_KEY 填了就优先于 DEEPSEEK_API_KEY；agent 规划需要模型支持 function calling
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# 流式：auto（默认，非流式请求被拒 400 时自动改用流式）/ true（始终流式）/ false
LLM_STREAM=auto
TAVILY_API_KEY=
APP_ENV=development
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=8
MAX_RESULTS=12
# 记忆库 SQLite 路径（留空关闭记忆）与后台复验周期（小时，0 关闭）
MEMORY_DB_PATH=data/querypilot.db
REVERIFY_INTERVAL_HOURS=6
# 额外搜索源：Telegram 公开频道用户名（逗号分隔，国内服务器需配 TG_PROXY）
TG_CHANNELS=
TG_PROXY=
# 资源站搜索 URL 模板（逗号分隔，{q} 为关键词），如 https://example.com/search?q={q}
EXTRA_SITES=
# 追剧订阅检查周期（小时，0 关闭）；有更新时额外推送到 webhook（可选，支持通用 {"text"} 与飞书机器人格式）
SUBSCRIBE_INTERVAL_HOURS=6
NOTIFY_WEBHOOK=
# 夸克扫码登录（默认开启）：每个用户扫码后转存到自己的网盘，登录凭证用 AES-256-GCM 加密存进记忆库
# COOKIE_SECRET 是加密密钥（任意长随机串）；留空则自动生成 data/.cookie_secret，换掉密钥后用户需重新扫码
QUARK_LOGIN=true
COOKIE_SECRET=
# 部署者自用的一键转存（可选，和扫码登录可同时存在）：夸克网页版登录后的 cookie，只放本地 .env，切勿提交或发给别人
# 两项都填写才开启；SAVE_TOKEN 是网页上点「转存」时要输入的口令，请用足够长的随机串
QUARK_COOKIE=
SAVE_TOKEN=
# 转存自动分类（默认开）：存到 {SAVE_ROOT_DIR}/电影/华语、{SAVE_ROOT_DIR}/电视剧/国产剧/片名 (年份) 等目录
# 先查 TMDB / 豆瓣的影视资料（类型、国家、年份），再交给 LLM 决定分类和片名；
# 没有 LLM 时按资料映射，资料都查不到才用文件名规则兜底（结果里会注明依据）。关闭后存到下面的 QUARK_SAVE_DIR_FID
SAVE_CLASSIFY=true
SAVE_ROOT_DIR=QueryPilot
# TMDB API Key（免费：themoviedb.org 注册 → 设置 → API；v3 API Key 或 v4 读访问令牌都可以）
TMDB_API_KEY=
# 国内直连 TMDB 不稳时可换成自己的反代地址，默认 https://api.themoviedb.org/3
TMDB_API_BASE=
# 豆瓣查询无需 key（非官方接口，可能限流）；false 关闭
DOUBAN_LOOKUP=true
# 转存到的网盘目录 fid（网页版打开目标文件夹后地址栏里的 fid；不确定就保持 0，即根目录）
QUARK_SAVE_DIR_FID=0

# ---------------- 防滥用（公开部署时建议按需调整；0 表示不限制） ----------------
# 同一 IP 每分钟请求数
RATE_LIMIT_PER_MINUTE=10
# 同一 IP 每天搜索总次数（含基础搜索），超过直接拒绝
IP_DAILY_SEARCHES=100
# 每天 AI（LLM）搜索次数：未登录按 IP 算，登录按账号算；用完自动降级为不耗 token 的基础搜索
ANON_DAILY_AI_SEARCHES=3
USER_DAILY_AI_SEARCHES=30
# 全站每天 LLM token 预算，到顶后全站降级为基础搜索（接口没返回用量时按字数估算）
SITE_DAILY_TOKEN_BUDGET=1000000
# 未登录每天搜索总次数，用完后要求扫码登录夸克（开放扫码登录时才生效）；登录后不限总次数，只受 AI 次数约束
ANON_DAILY_SEARCHES=10
# 邀请制：开启后新用户第一次扫码登录要填邀请码（老用户不用）；INVITE_CODES 是可反复使用的固定邀请码，逗号分隔
INVITE_REQUIRED=false
INVITE_CODES=
# 站长后台口令：请求头 X-Admin-Token 带上它才能看用量、封禁账号/IP、发邀请码；留空则后台关闭
# 请用足够长的随机串，如 python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# 同一句搜索多少分钟内直接复用上次结果（不调 LLM、不重搜）
SEARCH_CACHE_MINUTES=60
# 部署在 Nginx 等反向代理后面时设为 true，按 X-Forwarded-For 识别真实 IP（直连公网时保持 false，否则可伪造）
TRUST_PROXY=false

# ---------------- PanSou 搜索源（可选，默认关闭） ----------------
# 自建的 PanSou 地址；留空不启用。docker compose 部署填 http://pansou:8888，本机 Docker 填 http://127.0.0.1:8888
PANSOU_URL=
# PanSou 开启了认证时填它的 token
PANSOU_TOKEN=
# 等 PanSou 返回的最长秒数（它会先返回 4 秒内的结果，后台继续搜，下次同一关键词更全）
PANSOU_TIMEOUT=6
# plugin：只用白名单插件（推荐）；tg / all：也用 TG 频道，需先在 PanSou 的 CHANNELS 里配好人工筛过的频道
PANSOU_SRC=plugin
